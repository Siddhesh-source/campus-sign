# Postgres (docker compose up -d)
DATABASE_URL="postgresql://campusign:campusign@localhost:54329/campusign"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth client (Workspace: vit.edu). Leave empty locally to use dev sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated admin emails (bootstrap)
ADMIN_EMAILS="admin@vit.edu"
# Dev-only sign-in. Ignored (and rejected at startup) when NODE_ENV=production.
CAMPUSIGN_DEV_AUTH="1"
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts faculty signing keys at rest.
SIGNING_KEK=""
# Private document storage (outside the web root)
STORAGE_DIR="./storage"
