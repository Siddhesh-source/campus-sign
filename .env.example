# Postgres (docker compose up -d)
DATABASE_URL="postgresql://campusign:campusign@localhost:54329/campusign"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth client (Workspace: vit.edu). Leave empty locally to use dev sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated admin emails (bootstrap)
ADMIN_EMAILS="admin@vit.edu"
# Dev-only sign-in. Ignored (and rejected at startup) when NODE_ENV=production.
CAMPUSIGN_DEV_AUTH="1"
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts faculty signing keys at rest.
SIGNING_KEK=""
# Private document storage (outside the web root)
STORAGE_DIR="./storage"
# Blockchain trust layer (Phase 4). "off" queues events without sending them.
LEDGER_MODE="fabric"
FABRIC_PEER_ENDPOINT="localhost:7051"
FABRIC_PEER_HOST_ALIAS="peer0.org1.example.com"
FABRIC_MSP_ID="Org1MSP"
FABRIC_CRYPTO_PATH=".fabric/network/organizations/peerOrganizations/org1.example.com"
FABRIC_CHANNEL="campussign"
FABRIC_CHAINCODE="campussign"
