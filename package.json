{
  "name": "campusign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "ledger:up": "bash infra/fabric/network.sh up",
    "ledger:down": "bash infra/fabric/network.sh down",
    "ledger:relay": "tsx --conditions=react-server scripts/ledger.ts relay",
    "ledger:reconcile": "tsx --conditions=react-server scripts/ledger.ts reconcile",
    "ledger:smoke": "tsx --conditions=react-server scripts/ledger.ts smoke",
    "ops:backup": "bash scripts/ops/backup.sh",
    "ops:restore": "bash scripts/ops/restore.sh",
    "ops:rotate-kek": "tsx --conditions=react-server scripts/ops/cli.ts rotate-kek",
    "ops:affected": "tsx --conditions=react-server scripts/ops/cli.ts affected",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "setup": "pnpm db:up && pnpm prisma migrate deploy && pnpm db:seed"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@hyperledger/fabric-gateway": "^1.12.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.26.2"
}
