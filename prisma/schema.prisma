generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth core models ────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  suspendedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  classes     Class[]      @relation("ClassFaculty")
  enrollments Enrollment[]
  documents   Document[]
  credentials SigningCredential[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── CampusSign ────────────────────────────────────────────────────────────

enum FacultyAccessStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// Faculty role grant, keyed by institutional email so an admin can approve
/// someone before their first sign-in. Only admins move it to APPROVED.
model FacultyAccess {
  id          String              @id @default(cuid())
  email       String              @unique
  department  String?
  status      FacultyAccessStatus @default(PENDING)
  requestedAt DateTime?
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@map("faculty_access")
}

model Class {
  id           String    @id @default(cuid())
  facultyId    String
  faculty      User      @relation("ClassFaculty", fields: [facultyId], references: [id])
  name         String
  subjectCode  String
  academicYear String
  yearOfStudy  String
  division     String
  description  String?
  studentLimit Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  codes       ClassCode[]
  enrollments Enrollment[]
  documents   Document[]

  @@index([facultyId])
  @@map("class")
}

enum ClassCodeStatus {
  ACTIVE
  REVOKED
  SUPERSEDED
}

/// Join codes are never reused. At most one ACTIVE code per class
/// (partial unique index in the init migration). Expiry is computed from expiresAt.
///
///   ACTIVE ──rotate──► SUPERSEDED
///   ACTIVE ──revoke──► REVOKED
///   ACTIVE ──expiresAt passes──► (still ACTIVE in DB, treated as expired)
model ClassCode {
  id          String          @id @default(cuid())
  classId     String
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  code        String          @unique
  lookupKey   String          @unique
  status      ClassCodeStatus @default(ACTIVE)
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime        @default(now())
  endedAt     DateTime?

  enrollments Enrollment[]

  @@index([classId, status])
  @@map("class_code")
}

enum EnrollmentStatus {
  ACTIVE
  REMOVED
  LEFT
}

/// Students are approved automatically on join.
///   (none) ──join──► ACTIVE ──faculty remove──► REMOVED
///                    ACTIVE ──student leave───► LEFT
///   REMOVED/LEFT ──join with a valid code──► ACTIVE (same row)
model Enrollment {
  id        String           @id @default(cuid())
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User             @relation(fields: [studentId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  viaCodeId String?
  viaCode   ClassCode?       @relation(fields: [viaCodeId], references: [id])
  joinedAt  DateTime         @default(now())
  endedAt   DateTime?

  @@unique([classId, studentId])
  @@index([studentId, status])
  @@index([classId, status])
  @@map("enrollment")
}

/// Append-only. UPDATE/DELETE are rejected by a trigger (init migration).
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@map("audit_event")
}

/// Failed class-code lookups per key (user:<id> or ip:<addr>).
model CodeLookupLimit {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  lockCount   Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@map("code_lookup_limit")
}

// ── Phase 2: documents ─────────────────────────────────────────────────────

model DocumentType {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  active    Boolean        @default(true)
  documents Document[]
  steps     ApprovalStep[]

  @@map("document_type")
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  CORRECTIONS_REQUESTED
  REJECTED
}

///   DRAFT ──submit──► SUBMITTED ──review──► PENDING_REVIEW ──approve&sign──► APPROVED
///     ▲                                         ├──reject──► REJECTED
///     └──new version── CORRECTIONS_REQUESTED ◄──┘ request corrections
model Document {
  id               String         @id @default(cuid())
  classId          String
  class            Class          @relation(fields: [classId], references: [id])
  studentId        String
  student          User           @relation(fields: [studentId], references: [id])
  typeId           String
  type             DocumentType   @relation(fields: [typeId], references: [id])
  title            String
  status           DocumentStatus @default(DRAFT)
  currentVersionId String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  submittedAt      DateTime?
  /// Approval route frozen at submission: [{order,label,kind,approverEmail?}]
  routeSnapshot    Json?
  currentStep      Int            @default(1)
  /// Designated approvers whose step this document has reached (drives access + inbox).
  approverEmails   String[]       @default([])

  versions   DocumentVersion[] @relation("DocumentVersions")
  current    DocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  events     DocumentEvent[]
  signatures Signature[]

  @@index([studentId, updatedAt])
  @@index([classId, status])
  @@map("document")
}

/// Immutable file record. submittedAt != null means the version is locked.
model DocumentVersion {
  id           String    @id @default(cuid())
  documentId   String
  document     Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  number       Int
  storageKey   String    @unique
  sha256       String
  sizeBytes    Int
  pageCount    Int
  originalName String
  uploadedById String
  createdAt    DateTime  @default(now())
  submittedAt  DateTime?

  currentOf  Document?       @relation("CurrentVersion")
  events     DocumentEvent[]
  signatures Signature[]

  @@unique([documentId, number])
  @@index([sha256])
  @@map("document_version")
}

enum DocumentEventType {
  CREATED
  VERSION_UPLOADED
  SUBMITTED
  REVIEW_STARTED
  CORRECTIONS_REQUESTED
  REJECTED
  APPROVED_SIGNED
}

model DocumentEvent {
  id         String            @id @default(cuid())
  documentId String
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId  String?
  version    DocumentVersion?  @relation(fields: [versionId], references: [id])
  actorId    String
  actorRole  String
  type       DocumentEventType
  step       Int?
  reason     String?
  createdAt  DateTime          @default(now())

  @@index([documentId, createdAt])
  @@map("document_event")
}

enum ApproverKind {
  CLASS_FACULTY
  DESIGNATED
}

/// Ordered approval route for a document type. No rows = one step: the class faculty.
model ApprovalStep {
  id            String       @id @default(cuid())
  typeId        String
  type          DocumentType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  order         Int
  label         String
  kind          ApproverKind
  approverEmail String?

  @@unique([typeId, order])
  @@map("approval_step")
}

// ── Phase 3: signing ───────────────────────────────────────────────────────

enum CredentialStatus {
  ACTIVE
  ROTATED
  REVOKED
}

/// Ed25519 key pair. The private key is AES-256-GCM encrypted under SIGNING_KEK
/// (AAD = credential id) and never leaves the server.
model SigningCredential {
  id                  String           @id @default(cuid())
  facultyId           String
  faculty             User             @relation(fields: [facultyId], references: [id])
  keyId               String           @unique
  publicKeyPem        String
  encryptedPrivateKey String
  status              CredentialStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  retiredAt           DateTime?
  revokedReason       String?

  signatures Signature[]

  @@index([facultyId, status])
  @@map("signing_credential")
}

model Signature {
  id               String            @id
  code             String            @unique
  documentId       String
  document         Document          @relation(fields: [documentId], references: [id])
  versionId        String
  version          DocumentVersion   @relation(fields: [versionId], references: [id])
  credentialId     String
  credential       SigningCredential @relation(fields: [credentialId], references: [id])
  decision         String
  payload          String
  signature        String
  originalSha256   String
  signedSha256     String            @unique
  signedStorageKey String            @unique
  signedAt         DateTime
  stepOrder        Int               @default(1)
  totalSteps       Int               @default(1)
  /// Signature of the previous route step (its signed PDF is what this step stamped).
  previousSignatureId String?

  @@index([originalSha256])
  @@map("signature")
}

// ── Phase 4: blockchain trust layer ────────────────────────────────────────

enum LedgerOutboxStatus {
  PENDING
  CONFIRMED
  CONFLICT
}

/// Transactional outbox. Written in the same DB transaction as the business
/// event; the relay delivers it to Fabric. id = on-chain eventId (idempotency key).
///   PENDING ──relay ok/replay──► CONFIRMED
///   PENDING ──chaincode CONFLICT──► CONFLICT (never auto-resolved)
///   PENDING ──error──► PENDING (attempts++, backoff)
model LedgerOutbox {
  id            String             @id
  type          String
  documentId    String?
  signatureId   String?
  payload       String
  status        LedgerOutboxStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  /// Lease: a relay owns this row until then (no DB transaction is held during the ledger call).
  lockedUntil   DateTime?
  lastError     String?
  txId          String?
  blockNumber   BigInt?
  onChainAt     DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime           @default(now())

  @@index([status, nextAttemptAt])
  @@index([documentId])
  @@index([signatureId])
  @@map("ledger_outbox")
}

/// Disagreements between Postgres and the ledger, found by the reconciler.
model LedgerMismatch {
  id         String    @id @default(cuid())
  eventId    String
  kind       String
  detail     Json?
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt])
  @@index([eventId, kind])
  @@map("ledger_mismatch")
}
